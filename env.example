# --- Mock Core Banking ---
# Inside Docker: use service name. Outside Docker: use http://localhost:8000
MOCK_CB_URL=http://mock-cb:8000
# Qdrant vector store for RAG indexer (set in docker-compose environment, not .env).
# For local dev without docker, leave unset — mock CB will use embedded in-memory Qdrant.
# QDRANT_URL=http://localhost:6333

# --- Bot ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Tracing (Langfuse via OpenTelemetry) ---
# Set ENABLE_TRACING=false to disable tracing entirely (e.g. dev without Langfuse).
ENABLE_TRACING=true
# Inside Docker: use service name. Outside Docker: use http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
# Base64-encode your Langfuse key pair: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# Then paste here as: Authorization=Basic%20<BASE64>  (note: space MUST be %20)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<BASE64_PUBLIC_KEY:SECRET_KEY>
# Set to true to also print spans to stdout (useful for debugging auth/URL issues)
OTEL_CONSOLE_EXPORT=false

# --- Langfuse self-hosted secrets ---
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
# Short random string used for hashing
LANGFUSE_SALT=
# 64-char hex string: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
# Postgres credentials (used by Langfuse services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# ClickHouse credentials
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
# Redis auth token
REDIS_AUTH=
# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- Langfuse auto-provisioning (optional, leave empty to configure via UI) ---
# Fill these to skip manual first-run setup in the browser.
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=
